                    "accessToken": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "refreshToken": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "tokenType",
                    "accessToken",
